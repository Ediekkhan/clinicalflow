APP_ENV=hackathon
DATABASE_URL=sqlite+aiosqlite:///./hackathon.db
AUTO_CREATE_SCHEMA=true
ENABLE_TEST_FIXTURES=false
ENABLE_DEMO_CONTENT=false
ENABLE_HACKATHON_PROVIDERS=true
REDIS_ENABLED=false
AUTH_COOKIE_SECURE=false
SESSION_SECRET=hackathon-only-change-this-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHANNEL_WEBHOOK_SECRET=hackathon-webhook-secret
WHATSAPP_VERIFY_TOKEN=hackathon-whatsapp-token
