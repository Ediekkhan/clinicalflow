# Backend environment variables
# Copy this to .env.local and update values as needed.

# Local SQLite database (default)
DATABASE_URL=sqlite+aiosqlite:///synaptiverse.db

# Optionally override with a hosted PostgreSQL URL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis for caching / sessions (local default)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_KEY_PREFIX=synaptiverse
AUTH_RATE_LIMIT=10
PUBLIC_INTAKE_RATE_LIMIT=30
CHANNEL_WEBHOOK_SECRET=change-me
WHATSAPP_VERIFY_TOKEN=change-me

# Neo4j placeholder configuration for future knowledge graph support
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j
# Keep false unless a reachable graph has been seeded with backend/neo4j/schema.cypher.
NEO4J_ENABLED=false

# Persistent authentication sessions
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=14
# Set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Public booking routes are pinned to this deployment tenant; callers cannot override it.
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
# Local convenience only. Set false in deployed environments and run Alembic migrations.
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=30
LEAD_RETENTION_DAYS=180
