# Runtime safety
APP_ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_SCHEMA=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
SKIP_PHONE_VERIFICATION=false
ENABLE_TEST_FIXTURES=false
ENABLE_DEMO_CONTENT=false
DEFAULT_CREDENTIALS_PRESENT=false

# Required infrastructure and platform identity
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PLATFORM_TENANT_ID=replace-with-a-dedicated-random-uuid
CORS_ORIGINS=https://app.example.com

# Required secrets (generate independently; never reuse these placeholders)
SESSION_SECRET=replace-with-at-least-32-random-characters
CHANNEL_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_VERIFY_TOKEN=replace-with-a-private-provider-token

# Enable when Redis is provisioned
REDIS_ENABLED=false
REDIS_URL=redis://HOST:6379/0
